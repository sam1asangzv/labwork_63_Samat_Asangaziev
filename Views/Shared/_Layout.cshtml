<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] — MyChat</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head>
<body><header class="app-header"><a class="logo" asp-controller="Chat" asp-action="Index">MyChat</a><nav>@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Chat" asp-action="Index">Чат</a><a asp-controller="Profile" asp-action="Details">Профиль</a>@if(User.IsInRole("admin")){<a asp-controller="Admin" asp-action="Users">Администрирование</a>}<a asp-controller="Account" asp-action="Logout">Выйти</a> }</nav></header><main class="container app-main">@RenderBody()</main><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
