@model MyChat.Models.ApplicationUser
@{ ViewData["Title"] = "Профиль"; }
<section class="profile-card"><img src="@Model.AvatarPath" alt="Аватар"><div><h1>@Model.UserName</h1><dl><dt>Email</dt><dd>@Model.Email</dd><dt>Дата рождения</dt><dd>@Model.BirthDate.ToString("dd.MM.yyyy")</dd><dt>Сообщений в чате</dt><dd>@ViewBag.MessageCount</dd></dl>@if((bool)ViewBag.IsOwn){<a class="btn-primary-chat inline" asp-action="Edit">Редактировать профиль</a>}</div></section>
