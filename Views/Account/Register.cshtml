@model MyChat.Models.RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }
<section class="auth-card wide"><h1>Регистрация</h1><div asp-validation-summary="ModelOnly" class="validation"></div><form method="post" enctype="multipart/form-data" class="form-stack">@Html.AntiForgeryToken()<label>Username<input asp-for="UserName" autocomplete="username"><span asp-validation-for="UserName"></span></label><label>Email<input asp-for="Email" autocomplete="email"><span asp-validation-for="Email"></span></label><label>Дата рождения<input asp-for="BirthDate" type="date"><span asp-validation-for="BirthDate"></span></label><label>Аватар<input asp-for="Avatar" type="file" accept="image/*"><span asp-validation-for="Avatar"></span></label><label>Пароль<span class="password-wrap"><input asp-for="Password" autocomplete="new-password"><button type="button" class="password-toggle" aria-label="Показать пароль">◉</button></span><span asp-validation-for="Password"></span></label><button class="btn-primary-chat">Создать аккаунт</button></form><a asp-action="Login">Вернуться ко входу</a></section>
