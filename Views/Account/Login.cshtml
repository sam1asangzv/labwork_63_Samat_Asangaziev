@model MyChat.Models.LoginViewModel
@{ ViewData["Title"] = "Вход"; }
<section class="auth-card"><h1>Вход в MyChat</h1><div asp-validation-summary="ModelOnly" class="validation"></div><form method="post" class="form-stack">@Html.AntiForgeryToken()<label>Username или Email<input asp-for="Identifier" autocomplete="username"><span asp-validation-for="Identifier"></span></label><label>Пароль<span class="password-wrap"><input asp-for="Password" autocomplete="current-password"><button type="button" class="password-toggle" aria-label="Показать пароль">◉</button></span><span asp-validation-for="Password"></span></label><button class="btn-primary-chat">Войти</button></form><p>Нет аккаунта? <a asp-action="Register">Зарегистрироваться</a></p><p class="demo-login">Admin: <b>admin</b> / <b>Admin1</b></p></section>
