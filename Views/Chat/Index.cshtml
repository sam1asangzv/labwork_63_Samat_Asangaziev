@model MyChat.Models.ApplicationUser
@{ ViewData["Title"] = "Чат"; }
<section class="chat-shell" data-chat data-messages-url="@Url.Action("Messages")" data-send-url="@Url.Action("Send")" data-delete-url="@Url.Action("DeleteMessage", "Admin")" data-is-admin="@User.IsInRole("admin").ToString().ToLowerInvariant()"><div class="chat-title"><div><h1>Общий чат</h1><p>Последние 30 сообщений</p></div><a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.Id"><img src="@Model.AvatarPath" alt=""><span>@Model.UserName</span></a></div><div class="messages" id="messages" aria-live="polite"><p class="loading">Загрузка сообщений...</p></div><form id="messageForm" class="message-form">@Html.AntiForgeryToken()<textarea id="messageText" name="text" maxlength="150" placeholder="Введите сообщение" required></textarea><div class="composer-actions"><span id="charCount">0 / 150</span><button type="submit">Отправить</button></div><p id="chatError" class="validation"></p></form></section>
